# Heimdal API Configuration
# Copy to .env.local for local development

# Server
PORT=3000
NODE_ENV=development

# Database (Neon PostgreSQL)
# For local Docker: postgresql://heimdal:heimdal_dev@localhost:5432/heimdal?schema=public
# For Neon cloud:   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/heimdal?sslmode=require

# Redis (Upstash)
# For local Docker: redis://localhost:6379
# For Upstash:      redis://default:token@host:6379 (TLS required)
REDIS_URL=redis://default:password@host:6379

# Auth
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS
CORS_ORIGINS=http://localhost:8081,http://localhost:3001
